#!/usr/bin/env bash
set -euo pipefail
backend_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
jar_path="$backend_dir/target/tennis-0.0.1-SNAPSHOT.jar"
if [[ ! -f "$jar_path" ]]; then
  printf '%s\n' 'Build backend JAR first: ./mvnw package' >&2
  exit 2
fi
exec java -Dloader.main=com.shuminapp.tennis.ingestion.SourceSnapshotCli \
  -cp "$jar_path" org.springframework.boot.loader.launch.PropertiesLauncher "$@"
